# Alphanet proof system deployment config
# Non-secret values only — secrets (PRIVATE_KEY, OWNER_KEY, etc.) must be set in your shell
KUBECONTEXT=crypto-dev-us-east-1
PROOF_NAMESPACE=alphanet-world-chain-proof-nitro-worker
# WARNING: mutable tag on a measured-boot image. Every EIF rebuild changes PCR0 (enclave
# image) and PCR2 (application) — PCR1 (kernel) stays put — which silently drops the running
# enclave off the on-chain PCR allowlist until `just proof-approve-pcrs` is re-run. Pin a
# digest here when you need a stable measurement; either way `just proof-verify-pcrs alphanet`
# is what detects the drift.
PROOF_NITRO_IMAGE=ghcr.io/worldcoin/world-chain-proof-nitro:nightly
OP_NODE_NAMESPACE=alphanet-world-chain-node
OP_NODE_POD=alphanet-world-chain-node-0
OP_NODE_PORT=9545
