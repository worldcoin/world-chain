[Unit]
Description=World Chain OP rollup node
Wants=network-online.target world-chain.service
After=network-online.target world-chain.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=worldchain
Group=worldchain
EnvironmentFile=/etc/world-chain/node.env
ExecStart=/usr/local/bin/op-node $OP_NODE_ARGS
StateDirectory=world-chain/op-node
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
