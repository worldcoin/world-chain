# Draft reference configuration: mainnet RPC/follower; edit before use.
# Fill image references with qualified release digests. Do not commit node.env.
COMBINED_IMAGE=
WORLD_CHAIN_IMAGE=
OP_IMAGE=
NODE_UID=1000
NODE_GID=1000
OP_NODE_L1_ETH_RPC=
OP_NODE_L1_BEACON=
WORLD_CHAIN_ARGS="node --chain worldchain --datadir /var/lib/world-chain/execution --http --http.addr 127.0.0.1 --http.api eth,net,web3 --authrpc.addr 127.0.0.1 --authrpc.port 8551 --authrpc.jwtsecret /etc/world-chain/jwt.hex"
OP_NODE_ARGS="--network=worldchain --l2=http://127.0.0.1:8551 --l2.jwt-secret=/etc/world-chain/jwt.hex --rpc.addr=127.0.0.1 --rpc.port=9545 --p2p.priv.path=/var/lib/world-chain/op-node/p2p.key"
